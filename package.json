{
  "name": "intl-fiscal-registry",
  "version": "1.0.0",
  "description": "Vendor-neutral country, phone and fiscal document registry",
  "author": "rai-braz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaiVandeberg/intl-fiscal-registry.git"
  },
  "bugs": {
    "url": "https://github.com/RaiVandeberg/intl-fiscal-registry/issues"
  },
  "homepage": "https://github.com/RaiVandeberg/intl-fiscal-registry#readme",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./countries": {
      "types": "./dist/countries/index.d.ts",
      "import": "./dist/countries/index.js",
      "require": "./dist/countries/index.cjs"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "import": "./dist/documents/index.js",
      "require": "./dist/documents/index.cjs"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "import": "./dist/phone/index.js",
      "require": "./dist/phone/index.cjs"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js",
      "require": "./dist/compat/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "fiscal",
    "tax-id",
    "country",
    "phone",
    "typescript",
    "international",
    "validation"
  ],
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
